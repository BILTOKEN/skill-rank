---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import TagFilter from '../components/TagFilter.astro';
import RankingTable from '../components/RankingTable.astro';
import type { RankItem } from '../components/RankingTable.astro';
import rankings from '../../data/rankings.json';
import skillsMeta from '../../data/skills.json';
import rankedList from '../../data/ranked.json';
import watchlist from '../../data/watchlist.json';

const tags = ['前端', '后端', '设计', 'DevOps', '安全', '写作', 'AI', '工具'];

// 建立 repo → 中文简介 / 提示词 的映射
const zhMap = new Map(skillsMeta.map((s: any) => [s.repo, s.description_zh || '']));

function toItems(list: typeof rankings.weekly_growth): RankItem[] {
  return list.map((s, i) => ({
    rank: i + 1, repo: s.repo, name: s.name,
    description: zhMap.get(s.repo) || s.description,
    tags: s.tags || [],
    starsTotal: s.stars_total, starsAdded: s.stars_added_7d,
    commitsThisWeek: s.commits_7d,
    slug: s.repo.replace('/', '-'),
  }));
}

const weeklySkills = toItems(rankings.weekly_growth);
const activeSkills = toItems(rankings.active);
const totalSkills = toItems(rankings.total);

const rankedCount = rankedList.length;
const watchlistCount = watchlist.length;
const warmingMsg = (rankings as any).message || '';
---

<BaseLayout>
  <!-- Hero -->
  <div class="hero">
    <div class="container">
      <h1><span class="gradient-text">Claude Code Skill</span> 中文精选排行榜</h1>
      <p>精选有真实使用价值、一定热度和维护迹象的 Claude Code Skill</p>
      <div class="hero-stats">
        <div class="hero-stat">
          <div class="num">{rankedCount}</div>
          <div class="lbl">主榜精选</div>
        </div>
        <div class="hero-stat">
          <div class="num">{watchlistCount}</div>
          <div class="lbl">观察池</div>
        </div>
        <div class="hero-stat">
          <div class="num" style="font-size:0.95rem;padding-top:8px">{rankings.last_update || '2026-05-24 08:00'}</div>
          <div class="lbl">最后更新</div>
        </div>
      </div>
      {warmingMsg && (
        <div class="warming-notice">{warmingMsg}</div>
      )}
    </div>
  </div>

  <div class="container">
    <!-- 工具栏：搜索 + 筛选同一行 -->
    <div class="toolbar">
      <SearchBar />
      <TagFilter tags={tags} />
    </div>
    <!-- 口径说明 -->
    <p class="coverage-note">本站不是全量索引。低星或信息不完整的 Skill 会先进入观察池，暂不进入主榜。</p>

    <!-- 榜单切换 -->
    <div class="rank-tabs" id="rank-tabs">
      <button class="rank-tab active" data-tab="weekly_growth">📈 本周增长</button>
      <button class="rank-tab" data-tab="active">⚡ 活跃榜</button>
      <button class="rank-tab" data-tab="total">🏆 总榜</button>
    </div>

    <RankingTable type="weekly_growth" skills={weeklySkills} />
    <RankingTable type="active" skills={activeSkills} />
    <RankingTable type="total" skills={totalSkills} />

    <!-- 周报引流 -->
    <div class="weekly-section">
      <h2>📬 每周 Skill 排行榜周报</h2>
      <p>每周一推送热门 Skill 解读 + 精选推荐。关注公众号不走丢。</p>
      <a class="btn-primary" href="https://github.com/BILTOKEN/skill-rank/issues/new?template=skill-submit.md" target="_blank">推荐 Skill 给我们</a>
    </div>
  </div>
</BaseLayout>

<script>
  // 三栏切换
  const tabs = document.querySelectorAll<HTMLElement>('.rank-tab');
  const panels = document.querySelectorAll<HTMLElement>('.rank-panel');
  let currentTag = new URL(location.href).searchParams.get('tag') || '';

  function getActivePanel() {
    return document.querySelector<HTMLElement>('.rank-panel.active');
  }

  panels.forEach((p, i) => p.classList.toggle('active', i === 0));
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab!;
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      panels.forEach(p => p.classList.toggle('active', p.dataset.panel === target));
      // 切换面板时重新应用标签筛选，只对当前面板
      if (currentTag) applyTagFilter(currentTag);
    });
  });

  // 标签筛选
  const tagLinks = document.querySelectorAll<HTMLElement>('.filter-dropdown .tag');

  // 保存所有卡片原始排名（按面板分别存）
  panels.forEach(panel => {
    panel.querySelectorAll<HTMLElement>('.skill-card').forEach(card => {
      const badge = card.querySelector('.rank-badge') as HTMLElement;
      if (badge && !badge.dataset.origRank) {
        badge.dataset.origRank = badge.textContent || '';
        badge.dataset.origClass = badge.className;
      }
    });
  });

  function applyTagFilter(activeTag: string) {
    currentTag = activeTag;
    const panel = getActivePanel();
    if (!panel) return;
    const cards = panel.querySelectorAll<HTMLElement>('.skill-card');

    cards.forEach(card => {
      if (!activeTag) { card.style.display = ''; return; }
      const cardTags = (card.dataset.tags || '').split(',');
      card.style.display = cardTags.includes(activeTag) ? '' : 'none';
    });

    // 重新编号当前面板的可见卡片
    if (activeTag) {
      let newRank = 0;
      cards.forEach(card => {
        if (card.style.display !== 'none') {
          newRank++;
          const badge = card.querySelector('.rank-badge') as HTMLElement;
          if (badge) {
            badge.textContent = String(newRank);
            badge.className = `rank-badge${newRank <= 3 ? ` r${newRank}` : ''}`;
          }
        }
      });
    } else {
      // 恢复原始排名
      cards.forEach(card => {
        const badge = card.querySelector('.rank-badge') as HTMLElement;
        if (badge?.dataset.origRank) {
          badge.textContent = badge.dataset.origRank;
          badge.className = badge.dataset.origClass || '';
        }
      });
    }

    // 更新 URL
    const url = new URL(location.href);
    if (activeTag) url.searchParams.set('tag', activeTag);
    else url.searchParams.delete('tag');
    history.replaceState(null, '', url);

    // 更新标签 active 状态
    tagLinks.forEach(t => {
      const href = new URL(t.getAttribute('href')!, location.origin);
      t.classList.toggle('active', href.searchParams.get('tag') === activeTag || (!activeTag && !href.searchParams.get('tag')));
    });
  }

  tagLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const href = new URL((link as HTMLAnchorElement).href, location.origin);
      applyTagFilter(href.searchParams.get('tag') || '');
    });
  });

  // 页面加载时从 URL 恢复
  if (currentTag) applyTagFilter(currentTag);
</script>
