---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <div class="container" style="text-align:center;padding:80px 0">
    <div style="font-size:5rem;font-weight:800;color:var(--accent);margin-bottom:16px">404</div>
    <h1 style="font-size:1.5rem;margin-bottom:12px">这个页面不存在</h1>
    <p style="color:var(--text-secondary);margin-bottom:32px">你找的 Skill 可能还没收录，或者链接写错了。</p>
    <a href="/" class="btn-primary">回排行榜看看</a>
    <p style="margin-top:32px;color:var(--muted);font-size:0.85rem">
      想推荐 Skill？<a href="https://github.com/BILTOKEN/skill-rank/issues/new?template=skill-submit.md" target="_blank">提 Issue</a>
    </p>
  </div>
</BaseLayout>
