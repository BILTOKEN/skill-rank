---
export interface RankItem {
  rank: number; repo: string; name: string; description: string;
  tags: string[]; starsTotal: number; starsAdded: number;
  commitsThisWeek: number; slug: string;
}
const { type, skills } = Astro.props as { type: string; skills: RankItem[] };

const CATEGORY_TAGS = ['前端', '后端', '设计', 'DevOps', '安全', '写作', 'AI', '工具', '测试', '数据'];
function showTags(tags: string[]): string[] {
  return tags.filter(t => CATEGORY_TAGS.includes(t)).slice(0, 2);
}
---

<div class="rank-panel" data-panel={type}>
  <div class="rank-cards">
    {skills.map(s => (
      <a href={`/skills/${s.slug}`} class="skill-card" data-tags={s.tags.filter(t => CATEGORY_TAGS.includes(t)).join(',')} style="text-decoration:none;color:inherit">
        <div class={`rank-badge${s.rank <= 3 ? ` r${s.rank}` : ''}`}>{s.rank}</div>
        <div class="card-body">
          <div class="card-title">
            {s.name}
            {s.starsAdded > 100 ? <span class="mini-tag" style="background:var(--accent-soft);color:var(--accent);font-weight:600">🔥 热门</span> : s.starsAdded > 50 ? <span class="mini-tag" style="background:#e8f5e9;color:#2e7d32;font-weight:600">🆕 新锐</span> : ''}
          </div>
          <div class="card-desc">{s.description}</div>
          <div class="card-tags">
            {showTags(s.tags).map(t => <span class="mini-tag">{t}</span>)}
          </div>
        </div>
        <div class="card-stats">
          <div class="card-stat">
            <div class="val score">{(s.starsTotal / 1000).toFixed(1)}k</div>
            <div class="lbl">总收藏 <span class="tip" data-tip="GitHub Stars 总数，反映长期受欢迎程度">?</span></div>
          </div>
          <div class="card-stat">
            <div class="val">+{s.starsAdded}</div>
            <div class="lbl">本周新增 <span class="tip" data-tip="近 7 天新增的收藏数">?</span></div>
          </div>
          <div class="card-stat">
            <div class="val">{s.commitsThisWeek}</div>
            <div class="lbl">本周提交 <span class="tip" data-tip="近 7 天代码提交次数，反映维护频率">?</span></div>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>
